# ============================================================
# LETAN Media — Environment variables (EXAMPLE — no real secrets)
# Copy to `.env` and fill real values. `.env` is gitignored.
#
# For Cloudflare Pages Functions / chatbot-worker, set these as
# environment variables / secrets in the Cloudflare dashboard
# (or via `wrangler` / `wrangler pages secret`) — NOT in this file.
# ============================================================

# --- Cloudflare Pages Functions / chatbot-worker (AI) ---
# SECRET: Gemini API keys. Do NOT prefix with VITE_ (never expose to browser).
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-2.5-flash

# Optional single-key alias used by helper script gemini_request.sh
GEMINI_API_KEY=
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models

# --- chatbot-worker optional providers ---
HF_API_KEY=
NVIDIA_API_KEY=
CF_MODEL=@cf/meta/llama-3-8b-instruct
AI_PROVIDER=cloudflare

# --- Express server (server.js) — FB Messenger webhook ---
# SECRET
FB_PAGE_ACCESS_TOKEN=
FB_VERIFY_TOKEN=
# SECRET (ToolNet AI used by aimeta/ai.js)
TOOLNET_API_KEY=
TOOLNET_MODEL=groq/qwen/qwen3.6-27b
TOOLNET_URL=

# --- Contact form email (functions/api/send-email.js) ---
# SECRET
GMAIL_USER=
GMAIL_PASSWORD=

# --- Frontend (Vite, PUBLIC — VITE_ prefix is safe to expose) ---
VITE_CHATBOT_API_URL=/api/home-chat/chat

# --- Cloudflare R2 Assets Storage ---
R2_ACCOUNT_ID=
R2_ACCOUNT_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_TOKEN_VALUE=
R2_BUCKET=ltmedia
R2_PUBLIC_DOMAIN=https://image.letanmedia.me
